# Optional settings. Copy to .env; defaults work without this file.
COMPOSE_PORT=8642
# 0: 80 m polar DEM; 1: also 40 m, 5 m site DEMs and height errors.
DATA_TIER=0
# Regional overview cell size in meters (240 for the much larger scientific build).
REGION_RES=1920
SCIENCE_THREADS=4
PANO_TERRAIN_INTERP=catmull
PANO_RELIEF_AA=1
PANO_MICRO=1
PANO_MICRO_DEFAULT=
